---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/sections/Header.astro';
import PostMeta from '../components/ui/meta/PostMeta.astro';
import ShareButtons from '../components/ui/share/ShareButtons.astro';
import PostNav from '../components/ui/nav/PostNav.astro';
import fallbackImage from '../assets/images/blog-placeholder.png';
import { getAuthor } from '../data/author';
import { slugifyTag } from '../lib/slug';

type BlogData = CollectionEntry<'blog'>['data'];
type Props = BlogData & {
  showHeader?: boolean;
  prevPost?: { id: string; title: string } | null;
  nextPost?: { id: string; title: string } | null;
  readingTimeMin?: number;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  source,
  showHeader = true,
  prevPost = null,
  nextPost = null,
  readingTimeMin = 0,
} = Astro.props as Props;

const post = { data: Astro.props as BlogData };
const authorId = post.data.author ?? 'ColombiaFinanciera';

const siteOrigin = Astro.site ?? new URL(Astro.url).origin;
const site = siteOrigin.toString().replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const author = getAuthor(authorId);
const heroUrl = new URL((heroImage ?? fallbackImage).src, siteOrigin).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      headline: title,
      description,
      inLanguage: 'es-CO',
      url: canonicalURL,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      image: [heroUrl],
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: author.name,
        ...(author.reddit || author.github
          ? { sameAs: [author.reddit, author.github].filter(Boolean) }
          : {}),
      },
      publisher: { '@id': `${site}/#organization` },
      isPartOf: { '@id': `${site}/#website` },
      ...(post.data.category ? { articleSection: post.data.category } : {}),
      ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
      // NOTE: `timeRequired` is intentionally omitted. The reading-time
      // calculation currently always returns 1 (see PostMeta/readingTimeMin),
      // and publishing a known-wrong value as structured data is worse than
      // publishing none. Re-add once reading time is computed from post.body.
      ...(source?.threads?.length ? { citation: source.threads } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Artículos', item: `${site}/blog/` },
        ...(post.data.category
          ? [
              {
                '@type': 'ListItem',
                position: 3,
                name: post.data.category,
                item: `${site}/blog/category/${slugifyTag(post.data.category)}/`,
              },
            ]
          : []),
        {
          '@type': 'ListItem',
          position: post.data.category ? 4 : 3,
          name: title,
          item: canonicalURL,
        },
      ],
    },
  ],
};
---

<html lang="es" data-theme="dark" class="dark">
  <head>
    <BaseHead title={title} description={description} image={heroImage} type="article" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={author.name} />
    {post.data.category && <meta property="article:section" content={post.data.category} />}
    {post.data.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <style>
      main {
        width: 100%;
        max-width: calc(100% - 1.5rem);
        margin: auto;
        background: var(--color-bg-primary);
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: none;
      }
      .prose {
        width: 100%;
        max-width: 66ch;
        margin: auto;
        padding: 0.5rem 0;
        color: var(--color-text-secondary);
        line-height: 1.65;
      }
      .title {
        margin-bottom: 1.25rem;
        padding: 1.5rem 0 1rem;
        text-align: center;
        line-height: 1.2;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
        color: var(--color-text-primary);
      }
      .date {
        margin-bottom: 0.5em;
        color: var(--color-text-muted);
      }
      .last-updated-on {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {
          showHeader && (
            <div class="hero-image">
              {/* Above-the-fold LCP element: never lazy-load it. */}
              <Image
                width={1020}
                height={510}
                src={heroImage ?? fallbackImage}
                alt=""
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }
        <div class="prose">
          {
            showHeader && (
              <div class="title">
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {updatedDate && (
                    <div class="last-updated-on">
                      Actualizado el <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
                <h1>{title}</h1>
                <hr />
              </div>
            )
          }
          <ShareButtons title={title} url={Astro.url.toString()} />
          <PostMeta
            pubDate={pubDate}
            readingTimeMin={readingTimeMin}
            authorId={authorId}
            source={source}
          />
          <slot />
          <PostNav prev={prevPost} next={nextPost} />
          <p class="text-muted mt-6 text-sm leading-relaxed">
            Este contenido se basa en discusiones reales de la comunidad. También puedes ver
            conversaciones abiertas en
            <a
              href="https://reddit.com/r/colombiafinanciera"
              target="_blank"
              rel="noopener noreferrer"
              class="interactive-link mx-1">Reddit</a
            >
            o seguir el canal en
            <a
              href="https://t.me/ColombiaFinanciera"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ir al canal de Telegram"
              title="Telegram"
              class="interactive-link ml-1">Telegram</a
            >.
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
